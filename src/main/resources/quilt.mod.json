{
  "schema_version": 1,
  "quilt_loader": {
    "group": "com.retromod",
    "id": "retromod",
    "version": "${project.version}",
    "metadata": {
      "name": "Retromod",
      "description": "Helps older Minecraft mods run on newer versions by updating their bytecode, mixins, and loader metadata.",
      "contributors": {
        "Bownlux": "Owner"
      },
      "contact": {
        "homepage": "https://modrinth.com/mod/retromod",
        "sources": "https://github.com/Bownlux/Retromod",
        "issues": "https://github.com/Bownlux/Retromod/issues"
      },
      "icon": "assets/retromod/icon.png",
      "license": "MIT"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "main": "com.retromod.core.Retromod",
      "client": "com.retromod.core.RetromodClient",
      "server": "com.retromod.core.RetromodServer",
      "preLaunch": "com.retromod.core.RetromodPreLaunch"
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.20.0"
      },
      {
        "id": "minecraft",
        "versions": ">=1.20"
      },
      {
        "id": "java",
        "versions": ">=17"
      }
    ]
  }
}
